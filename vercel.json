{
  "framework": null,
  "buildCommand": "node --test engine.test.mjs && node --check app.mjs && mkdir -p dist && cp index.html app.mjs engine.mjs style.css dist/",
  "outputDirectory": "dist",
  "installCommand": "true",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
